# Copie este arquivo para .env.local (desenvolvimento) e configure as mesmas
# variáveis em Project Settings → Environment Variables na Vercel (produção).

# Neon (ou outro Postgres) → connection string com pooling.
# https://neon.tech → crie um projeto → Connection string
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.neon.tech/neondb?sslmode=require

# Segredo usado para assinar o cookie de sessão (JWT). Gere um valor aleatório
# forte, por exemplo com: openssl rand -base64 32
JWT_SECRET=troque-por-um-valor-aleatorio-longo

# Vercel Blob (Storage) → Project Settings → Storage → Create Database → Blob
# O token é gerado automaticamente ao criar o Blob store e conectar ao projeto.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Resend (envio de e-mail) → https://resend.com → API Keys
RESEND_API_KEY=re_xxx
# Domínio verificado no Resend para o campo "From". Enquanto nenhum domínio
# estiver verificado, use onboarding@resend.dev (só entrega para o e-mail da
# sua própria conta Resend).
EMAIL_FROM=Nova Medtec Boletos <notificacoes@SEU-DOMINIO-VERIFICADO.com.br>

# E-mails autorizados a criar conta de administradora (separados por vírgula).
ADMIN_EMAIL_ALLOWLIST=karinavf83@gmail.com
